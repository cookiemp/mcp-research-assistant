# Copy this file to .env and fill in your own values.
# NEVER commit the real .env - it is gitignored.

# --- LLM (required for the agent app) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the primary model is rate limited (429) or 503.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- MCP server ---
# Folder the document tools may read. Defaults to ./documents
DOCS_DIR=./documents
# Hard limits applied to model-supplied arguments.
MAX_SEARCH_RESULTS=10
MAX_FETCH_CHARS=8000
# Set to DEBUG for verbose stderr logging.
LOG_LEVEL=INFO
# Set to 1 to ignore this .env file and use only process env (production).
# MCP_SKIP_DOTENV=1

# --- Streamable HTTP transport ---
# The HTTP transport refuses to start without authentication.
# Generate real tokens with:  python scripts/make_tokens.py
# Then paste the printed line here (JSON: "<token>" -> scopes):
# MCP_AUTH_TOKENS={"replace-with-a-long-random-token": ["docs:read", "web:read"]}
# Single-token alternative (used only when MCP_AUTH_TOKENS is empty):
# MCP_API_TOKEN=another-long-random-token
# MCP_SCOPES=docs:read,web:read
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Set when the server sits behind a proxy, e.g. https://mcp.example.com
# MCP_PUBLIC_URL=https://mcp.example.com

# --- CLI client (only needed for --transport http) ---
MCP_CLIENT_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8000/mcp
# MCP_TOKEN=paste-the-docs-or-full-token-here

# --- Optional ---
# Web search uses DuckDuckGo and needs no key.
# Optional polite User-Agent for fetch_url.
HTTP_USER_AGENT=research-assistant/1.0 (+https://example.com)
